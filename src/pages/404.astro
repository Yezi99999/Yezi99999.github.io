---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 · Yezi99999" description="404 — 页面不存在">
  <main>
    <h1>404</h1>
    <p>这个页面不存在。</p>
    <p><a href="/">返回首页</a></p>
  </main>
</BaseLayout>

<style>
  :global(:root) {
    color-scheme: dark;
  }

  :global(body) {
    margin: 0;
    padding: 5rem 1.5rem;
    background: #0f172a;
    color: #e2e8f0;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: 5rem;
    color: #7dd3fc;
  }

  a {
    color: #7dd3fc;
  }
</style>
